      "id": "c6597663-27cd-47d6-a08c-6f11272cc6a2",
      "name": "Get lead context",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -520,
        240
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Supabase service key (crm)"
        }
      },
