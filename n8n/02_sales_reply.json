    {
      "parameters": {
        "jsCode": "// เอาเฉพาะข้อความที่ \"Reply\" การ์ดลีด (มี Lead ID รูปแบบ YYYYMMDD-NNNNNN) จากคน ไม่ใช่บอท\nconst m = $('Telegram Trigger').first().json;\nconst msg = m.message || {};\nconst text = (msg.text || msg.caption || '').trim();\nconst quoted = (msg.reply_to_message && (msg.reply_to_message.text || msg.reply_to_message.caption)) || '';\nconst lead = (quoted.match(/(\\d{8}-\\d{6})/) || [])[1] || '';\nif (!text || !lead || (msg.from && msg.from.is_bot)) return [];\nreturn [{ json: { update_id: m.update_id, lead_code: lead, text, from_id: String(msg.from.id), chat_id: String(msg.chat.id), message_id: msg.message_id } }];"
      },
      "id": "c057d531-c9cc-470c-aaad-b44ccb39739a",
      "name": "Parse reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1180,
        300
      ]
    },
    {
