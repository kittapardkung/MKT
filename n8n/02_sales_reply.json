      "id": "6e38321f-7b44-4d6c-9990-56eb5b82b294",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        -140,
        460
      ],
      "credentials": {
        "openAiApi": {
          "id": "",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"contact_outcome\": {\n      \"type\": \"string\"\n    },\n    \"lead_status\": {\n      \"type\": \"string\"\n    },\n    \"lead_temperature\": {\n      \"type\": \"string\"\n    },\n    \"next_follow_up\": {\n      \"type\": \"string\"\n    },\n    \"summary\": {\n      \"type\": \"string\"\n    },\n    \"Customer_Email\": {\n      \"type\": \"string\"\n    },\n    \"Customer_Line_ID\": {\n      \"type\": \"string\"\n    },\n    \"Customer_Address\": {\n      \"type\": \"string\"\n    },\n    \"Customer_Province\": {\n      \"type\": \"string\"\n    },\n    \"Customer_District\": {\n      \"type\": \"string\"\n    },\n    \"Customer_Postal_Code\": {\n      \"type\": \"string\"\n    },\n    \"Occupation\": {\n      \"type\": \"string\"\n    },\n    \"Interested_Brand\": {\n      \"type\": \"string\"\n    },\n    \"Variant\": {\n      \"type\": \"string\"\n    },\n    \"Preferred_Color\": {\n      \"type\": \"string\"\n    },\n    \"Preferred_Variant\": {\n      \"type\": \"string\"\n    },\n    \"Purchase_Type\": {\n      \"type\": \"string\"\n    },\n    \"Budget\": {\n      \"type\": \"string\"\n    },\n    \"Vehicle_Price\": {\n      \"type\": \"string\"\n    },\n    \"Down_Payment\": {\n      \"type\": \"string\"\n    },\n    \"Interest_Rate\": {\n      \"type\": \"string\"\n    },\n    \"Monthly_Payment\": {\n      \"type\": \"string\"\n    },\n    \"Loan_Term\": {\n      \"type\": \"string\"\n    },\n    \"Financing_Required\": {\n      \"type\": \"string\"\n    },\n    \"Financing_Status\": {\n      \"type\": \"string\"\n    },\n    \"Finance_Amount\": {\n      \"type\": \"string\"\n    },\n    \"Finance_Note\": {\n      \"type\": \"string\"\n    },\n    \"Financing_Bank\": {\n      \"type\": \"string\"\n    },\n    \"Has_Trade_In\": {\n      \"type\": \"string\"\n    },\n    \"Trade_In_Brand\": {\n      \"type\": \"string\"\n    },\n    \"Trade_In_Model\": {\n      \"type\": \"string\"\n    },\n    \"Trade_In_Year\": {\n      \"type\": \"string\"\n    },\n    \"Trade_In_Expected_Price\": {\n      \"type\": \"string\"\n    },\n    \"Trade_In_Appraised_Price\": {\n      \"type\": \"string\"\n    },\n    \"Trade_In_Status\": {\n      \"type\": \"string\"\n    },\n    \"Promotion_Name\": {\n      \"type\": \"string\"\n    },\n    \"Discount_Amount\": {\n      \"type\": \"string\"\n    },\n    \"Free_Items\": {\n      \"type\": \"string\"\n    },\n    \"Closing_Condition\": {\n      \"type\": \"string\"\n    },\n    \"Test_Drive_Date\": {\n      \"type\": \"string\"\n    },\n    \"Quotation_Date\": {\n      \"type\": \"string\"\n    },\n    \"Quotation_Amount\": {\n      \"type\": \"string\"\n    },\n    \"Competitor\": {\n      \"type\": \"string\"\n    },\n    \"Notes\": {\n      \"type\": \"string\"\n    }\n  }\n}"
      },
      "id": "61e3ca52-7989-477a-bbe6-515899ff6480",
      "name": "Structured Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        40,
        460
      ]
    },
    {
      "parameters": {
        "jsCode": "// รวมผล AI เป็น p_ai (ถ้า AI ล้ม = {} ข้อความเซลล์ยังถูกบันทึกเป็นหลักฐาน) แล้วเรียก crm.record_sales_reply\nconst p = $('Parse reply').first().json;\nlet ai = ($input.first() && $input.first().json && $input.first().json.output) || {};\nif (typeof ai !== 'object') ai = {};\nconst clean = {};\nfor (const [k, v] of Object.entries(ai)) { if (v !== null && v !== undefined && String(v).trim() !== '') clean[k] = String(v).trim(); }\nreturn [{ json: { p_update_id: Number(p.update_id), p_lead_code: p.lead_code, p_telegram_user_id: p.from_id, p_reply_text: p.text, p_ai: clean } }];"
      },
      "id": "66a722ee-15bc-4478-b67b-9374c05581e3",
      "name": "Merge AI output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        200,
        240
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.supabaseUrl }}/rest/v1/rpc/record_sales_reply",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Profile",
              "value": "crm"
            },
            {
              "name": "Accept-Profile",
              "value": "crm"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 20000
        }
      },
      "id": "ffd365e1-b1ef-4a8c-8ae2-3aa63a5c96b7",
      "name": "Supabase record_sales_reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        420,
        240
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Supabase service key (crm)"
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1500,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// แปลผลจากฐานข้อมูลเป็นข้อความตอบเซลล์ (ไม่ตอบถ้าเป็นข้อความซ้ำ)\nconst r = $json;\nconst p = $('Parse reply').first().json;\nconst ai = $('Merge AI output').first().json.p_ai || {};\nconst TH = { accepted: 'รับลีด', contact: 'บันทึกการติดต่อสำเร็จ', profile: 'อัปเดต Customer Card', next_follow_up: 'นัดติดตามครั้งถัดไป', temperature: 'อุณหภูมิลีด', stage: 'เปลี่ยนสถานะ' };\nlet text = '';\nif (r.status === 'ok') {\n  const applied = (r.applied || []).map(x => '• ' + (TH[x] || x));\n  const review = (r.needs_review || []).map(x => '• ' + (x.startsWith('stage:') ? 'สถานะ ' + x.slice(6) + ' — ต้องให้ผู้จัดการตรวจ/แนบหลักฐานในระบบ' : x === 'next_follow_up' ? 'วันนัดไม่สมเหตุสมผล (ไม่ได้ใช้)' : x));\n  text = '✅ บันทึกเรียบร้อย\\n🆔 ' + r.lead_code + '\\n' + (ai.summary ? '📝 ' + ai.summary + '\\n' : '') +\n    (applied.length ? '\\nระบบอัปเดต:\\n' + applied.join('\\n') : '\\nบันทึกข้อความเป็นหลักฐานแล้ว') +\n    (review.length ? '\\n\\n⚠️ รอมนุษย์ตรวจสอบ:\\n' + review.join('\\n') : '') +\n    (!ai.next_follow_up ? '\\n\\n📅 อย่าลืมตั้งวันนัดติดตามครั้งถัดไปในระบบ' : '');\n} else if (r.status === 'forbidden') text = '⛔ คุณไม่ใช่เจ้าของลีดนี้ จึงบันทึกไม่ได้';\nelse if (r.status === 'lead_not_found') text = '❓ ไม่พบลีด ' + p.lead_code + ' ในระบบ';\nelse if (r.status === 'closed_lead_noted') text = 'ℹ️ ลีดนี้ปิดการขายแล้ว บันทึกข้อความเป็นหมายเหตุเท่านั้น';\nelse return [];   // duplicate\nreturn [{ json: { chatId: p.chat_id, text, replyTo: p.message_id } }];"
      },
      "id": "5a1abea8-a499-4214-a6eb-b14a443f4af7",
      "name": "Build reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
