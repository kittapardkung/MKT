      "id": "7637db0b-4ae9-4cc8-ab3b-62db93c48325",
      "name": "Get lead context",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -520,
        240
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Supabase service key (crm)"
        }
      },
      "alwaysOutputData": true
