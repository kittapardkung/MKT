              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 20000
        }
      },
      "id": "aa6827f1-d61d-459f-98b0-6be407af1130",
      "name": "Supabase ingest_message",
      "type": "n8n-nodes-base.httpRequest",
