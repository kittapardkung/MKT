      "id": "67870262-7079-45a4-9624-b2f6d3e57c04",
      "name": "Supabase ingest_message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        100,
        460
      ],
      "credentials": {
        "httpHeaderAuth": {
