      "id": "7bb6c6b2-113a-42ce-acd7-91de4c4c614a",
      "name": "HAVE TEL Y/N?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -10,
        460
      ]
