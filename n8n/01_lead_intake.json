        "options": {
          "timeout": 20000
        }
      },
      "id": "3c6fe3eb-49da-49a8-8c00-d92e01bf82c7",
      "name": "Supabase ingest_message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        100,
        460
      ],
      "credentials": {
        "httpHeaderAuth": {
