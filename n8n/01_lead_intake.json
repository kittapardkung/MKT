      "id": "821b4407-f04b-4d56-aefa-419ead4e8c83",
      "name": "Supabase ingest_message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        100,
        460
      ],
      "credentials": {
        "httpHeaderAuth": {
