    {
      "parameters": {
        "jsCode": "// แตกข้อความจาก Facebook ทีละรายการ (ไม่ตรวจลายเซ็น) — รับเฉพาะเพจ Wuling Chonburi, ข้าม echo/ไฟล์/read receipt\nconst req = $input.first().json;\nconst body = req.body || {};\nconst out = [];\nfor (const entry of (body.entry || [])) {\n  if (String(entry.id) !== '1025952777273131') continue;\n  for (const m of (entry.messaging || [])) {\n    const msg = m.message;\n    if (!msg || msg.is_echo || !msg.text || !msg.mid) continue;\n    out.push({ json: { message_id: msg.mid, userid: String((m.sender && m.sender.id) || ''), text: String(msg.text), timestamp: m.timestamp || Date.now() } });\n  }\n}\nreturn out;"
      },
      "id": "63e10ed1-af0d-463c-a57f-e69bb30f00ef",
      "name": "Parse events",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1180,
        300
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.text }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are a data extraction assistant for a CRM at a Thai EV car dealership.\nExtract from the customer's Facebook Messenger message: customerName, phoneNumber (any format, digits only is fine), interestedModel (car model they mention), and leave a field as an empty string when it is not present.\nNever invent values. Return exactly the JSON schema requested."
        }
      },
      "id": "142619e2-ebce-4103-8e30-c4d8e667916a",
      "name": "Extract Customer Data",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2.2,
      "position": [
        -500,
        460
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "operation": "removeItemsSeenInPreviousExecutions",
        "dedupeValue": "={{ $json.message_id }}",
        "options": {}
      },
      "id": "7ad933d1-f868-451c-a67c-2b146c899676",
      "name": "Remove Duplicates (mid)",
      "type": "n8n-nodes-base.removeDuplicates",
      "typeVersion": 2,
