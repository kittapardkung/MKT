      "id": "de0ecef4-d7e2-46f3-a8e9-b045c436ee25",
      "name": "HAVE TEL Y/N?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -10,
        460
