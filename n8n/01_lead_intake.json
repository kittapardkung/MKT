      "id": "462da8a2-bb11-47ab-8b14-86503b5b8f7d",
      "name": "Supabase ingest_message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        100,
        460
      ],
      "credentials": {
        "httpHeaderAuth": {
