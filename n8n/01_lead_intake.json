        }
      },
      "id": "45b328ff-2ed6-4ce1-a17d-b726fcb484d1",
      "name": "Supabase ingest_message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        100,
        460
      ],
      "credentials": {
        "httpHeaderAuth": {
